---
// The threshold — the book's half-title, and the only page that is not itself
// part of the work.
import { Picture } from "astro:assets";
import Book from "../layouts/Book.astro";
import BookFoot from "../components/BookFoot.astro";
import { photo } from "../lib/images.js";
import book from "../content/book/book.json";
import { manuscript } from "../lib/manuscript.js";

const { leaves, prelude } = manuscript();
const firstLeaf = leaves[0].path;
const firstPreludeLeaf = prelude.leaves[0].path;
const resumableLeafPaths = leaves
  .filter(({ type }) => type !== "end")
  .map(({ path }) => path);
---

<Book
  title="Habib Saleh"
  description={`${book.title} — ${book.subtitle} Photographs and writing by Habib Saleh, made in Lebanon.`}
  path="/"
  image={photo("cover/manuscript-cover.jpg")}
  screen="threshold threshold-cover"
>
  {/* The jacket. Eager and high priority: it is the largest paint on the
      first screen a reader ever sees, and lazy-loading it would leave the
      title hanging over bare paper for a beat. */}
  <div class="cover">
    <Picture
      src={photo("cover/manuscript-cover.jpg")}
      alt="An olive tree standing in poppies. Joun, Lebanon."
      formats={["avif"]}
      fallbackFormat="jpeg"
      widths={[900, 1400, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <div class="head">
    <span class="wordmark">Habib Saleh</span>
    <span class="wordmark edition">{book.edition}</span>
  </div>

  <section class="threshold-body">
    <h1 class="work-title">{book.title}</h1>
    <p class="work-subtitle">{book.subtitle}</p>

    <div class="doors">
      <a class="door" href={firstPreludeLeaf}>Begin the work →</a>
      {/* Revealed by the script below only when a bookmark exists, so a
          first-time reader is never offered a place to resume. */}
      <a
        class="door-small"
        id="resume"
        href={firstLeaf}
        data-leaves={JSON.stringify(resumableLeafPaths)}
        hidden
      >Continue reading</a>
      <a class="door-small" href="/contents/">Contents</a>
    </div>
  </section>

  <BookFoot commissions prints />
</Book>

<script>
  // The bookmark is a leaf's address rather than its number: an address is
  // built from the leaf's own content, so inserting a photograph ahead of it
  // never moves anyone's place in the book.
  const resume = document.getElementById("resume");
  try {
    const saved = window.localStorage.getItem("tp:leaf");
    const validLeaves = new Set(JSON.parse(resume?.dataset.leaves || "[]"));
    if (resume && saved && validLeaves.has(saved)) {
      resume.setAttribute("href", saved);
      resume.hidden = false;
    } else if (saved) {
      window.localStorage.removeItem("tp:leaf");
    }
  } catch (e) {
    /* private mode — the offer simply never appears */
  }
</script>
