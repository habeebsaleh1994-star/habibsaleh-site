---
// The reader. One route per leaf, so every photograph has an address a curator
// can send to someone, and so a leaf only ever loads its own image.
//
// A leaf's address comes from its content, never from its position in the run
// — inserting a plate ahead of another does not move the one behind it.
import { Picture } from "astro:assets";
import Book from "../../layouts/Book.astro";
import TurnNav from "../../components/TurnNav.astro";
import { photo } from "../../lib/images.js";
import { manuscript } from "../../lib/manuscript.js";
import book from "../../content/book/book.json";

export async function getStaticPaths() {
  const { leaves, extent } = manuscript();
  return leaves.map((leaf) => ({
    // The route is the leaf's path minus the /read/ mount and its slashes.
    params: { leaf: leaf.path.replace(/^\/read\//, "").replace(/\/$/, "") || undefined },
    props: { leaf, extent },
  }));
}

const { leaf, extent } = Astro.props;
const mv = leaf.movement;

// Head copy differs per leaf type so a shared plate does not preview as the
// whole book.
const meta = {
  interleaf: {
    title: `${mv?.title} — Habib Saleh`,
    description: (mv?.opening && mv.opening[0]) || book.subtitle,
  },
  frontmatter: {
    title: `${mv?.title} — Habib Saleh`,
    description: (mv?.opening && mv.opening[0]) || book.subtitle,
  },
  photo: {
    title: `${mv?.title} — Habib Saleh`,
    description: leaf.photo?.cap || book.subtitle,
  },
  film: {
    title: `${leaf.film?.title} — a film by Habib Saleh`,
    description: leaf.film?.cap || book.subtitle,
  },
  // A fragment previews as the movement, not as itself. Its sentence read
  // alone in a link preview is the whole point of the leaf spent for nothing.
  fragment: {
    title: `${mv?.title} — Habib Saleh`,
    description: book.subtitle,
  },
  story: {
    title: `${leaf.story?.story} — Habib Saleh`,
    description:
      (leaf.story?.opening && leaf.story.opening[0]) ||
      `A story within ${mv?.title}.`,
  },
  closing: {
    title: `${mv?.title} — Habib Saleh`,
    description: (mv?.closing && mv.closing[0]) || book.subtitle,
  },
  end: {
    title: `The present edge — Habib Saleh`,
    description: book.end.note,
  },
}[leaf.type];

// The plate's own frame, so the caption aligns to the photograph's left edge
// rather than to the stage.
const src = leaf.type === "photo" ? photo(leaf.photo.photo) : null;
const poster = leaf.type === "film" ? photo(leaf.film.poster) : null;
const ogImage =
  src ??
  poster ??
  photo(
    mv?.sequence?.find((i) => i.photo)?.photo ??
      "colored-air/HS-ColoredAir-2025-01.JPG",
  );
---

<Book
  title={meta.title}
  description={meta.description}
  path={leaf.path}
  image={ogImage}
  screen="reader"
  rises={false}
>
  <div class="spine">
    <a class="spine-back" href="/contents/">Contents</a>
    <span class="spine-title">{leaf.type === "end" ? "" : mv?.title}</span>
    <span class="spine-counter">
      {leaf.type === "end" ? "" : `${leaf.number} / ${extent}`}
    </span>
  </div>

  {/* Only the leaf body rises, at the shorter duration — the spine and the
      turn controls are furniture and stay put between leaves. */}
  <div
    class="leaf rises-leaf"
    data-bookmark-path={leaf.type === "end" ? undefined : leaf.path}
    data-bookmark-clear={leaf.type === "end" ? "" : undefined}
  >
    {leaf.type === "interleaf" && (
      <div class="interleaf">
        <div class="ornament"></div>
        <div class="interleaf-roman">{mv.roman}</div>
        <h1 class="interleaf-title">{mv.title}</h1>
        <div class="interleaf-years">{mv.years}</div>
      </div>
    )}

    {leaf.type === "frontmatter" && (
      <div class="frontmatter">
        {mv.epigraph && (
          <>
            <p class="epigraph">{mv.epigraph}</p>
            {mv.epigraphSource && (
              <div class="epigraph-source">— {mv.epigraphSource}</div>
            )}
            {mv.epigraphNote && <p class="epigraph-note">{mv.epigraphNote}</p>}
          </>
        )}
        {mv.opening && (
          <div class="frontmatter-prose">
            {mv.opening.map((para) => <p>{para}</p>)}
          </div>
        )}
      </div>
    )}

    {leaf.type === "photo" && (
      <figure class="plate">
        {/* The photograph is a button when it carries a caption: a tap reveals
            the words, so the page can hold only the image until asked. The
            caption is also the alt text, so a screen reader loses nothing by
            the hiding. */}
        <div class="plate-image" data-caption-toggle={leaf.photo.cap ? "" : undefined}>
          <Picture
            src={src}
            alt={leaf.photo.cap || mv.title}
            formats={["avif"]}
            fallbackFormat="jpeg"
            widths={[800, 1400, 2200]}
            sizes="(max-width: 640px) 100vw, 1000px"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        {leaf.photo.cap && (
          <figcaption class="plate-caption">
            <button
              class="caption-toggle"
              id="cap-toggle"
              aria-expanded="false"
              aria-controls="cap-text"
            >caption</button>
            <p id="cap-text" hidden>{leaf.photo.cap}</p>
          </figcaption>
        )}
      </figure>
    )}

    {leaf.type === "film" && (
      <figure class="plate film">
        {/* Habib's own frame, served from this site. Nothing is requested from
            YouTube until the reader presses play — so turning past a film
            costs no round trip to Google and sets no cookie. */}
        <button class="film-frame" data-film={leaf.film.film} aria-label={`Play ${leaf.film.title}`}>
          <Picture
            src={poster}
            alt={leaf.film.cap || leaf.film.title}
            formats={["avif"]}
            fallbackFormat="jpeg"
            widths={[800, 1400]}
            sizes="(max-width: 640px) 100vw, 1000px"
            loading="eager"
            decoding="async"
          />
          <span class="film-play" aria-hidden="true">
            <svg viewBox="0 0 44 44" width="44" height="44">
              <circle cx="22" cy="22" r="21" fill="none" stroke="currentColor" stroke-width="1" />
              <path d="M18 14.5 L31 22 L18 29.5 Z" fill="currentColor" />
            </svg>
          </span>
        </button>
        <figcaption class="plate-caption film-caption">
          <p>{leaf.film.cap}</p>
          <p class="film-elsewhere">
            <a href={`https://www.youtube.com/watch?v=${leaf.film.film}`} target="_blank" rel="noopener">
              Watch on YouTube ↗
            </a>
          </p>
        </figcaption>
      </figure>
    )}

    {leaf.type === "fragment" && (
      /* No label, no title, no rule. A fragment that announces itself becomes
         a caption for the plate the reader just turned away from. `hold` is
         for a single line meant to stand alone at scale. */
      <div
        class:list={[
          "fragment-leaf",
          { held: leaf.fragment.hold, long: leaf.fragment.fragment.length > 3 },
        ]}
      >
        {leaf.fragment.fragment.map((para) => <p>{para}</p>)}
      </div>
    )}

    {leaf.type === "story" && (
      <div class="story-leaf">
        <div class="story-label">A story within {mv.title}</div>
        <h2 class="story-leaf-title">{leaf.story.story}</h2>
        <div class="story-leaf-years">{leaf.story.years}</div>
        {leaf.story.opening && (
          <div class="story-opening">
            {leaf.story.opening.map((para) => <p>{para}</p>)}
          </div>
        )}
      </div>
    )}

    {leaf.type === "closing" && (
      <div class="closing">
        <div class="closing-prose">
          {mv.closing.map((para) => <p>{para}</p>)}
        </div>
        {mv.credit && <p class="credit">{mv.credit}</p>}
      </div>
    )}

    {leaf.type === "end" && (
      <div class="end-leaf">
        <p class="end-line">{book.end.line}</p>
        <p class="end-note">{book.end.note}</p>
        <div class="end-links">
          <a href="/contents/">↑ Contents</a>
          <a href="/colophon/">Colophon</a>
        </div>
      </div>
    )}
  </div>

  <TurnNav prev={leaf.prev} next={leaf.next} />
</Book>

<script>
  // The current numbered leaf is remembered. Its address comes from the same
  // manuscript object that renders the counter, Contents, and turn links.
  const bookmarkLeaf = document.querySelector(
    "[data-bookmark-path], [data-bookmark-clear]",
  );
  try {
    const bookmarkPath = bookmarkLeaf?.getAttribute("data-bookmark-path");
    if (bookmarkPath) {
      window.localStorage.setItem("tp:leaf", bookmarkPath);
    } else if (bookmarkLeaf?.hasAttribute("data-bookmark-clear")) {
      window.localStorage.removeItem("tp:leaf");
    }
  } catch (e) {
    /* private mode — the book simply does not remember */
  }

  // Captions are held back until asked for — the photograph should not arrive
  // pre-explained. Tapping the plate or the small "caption" label reveals the
  // words, and the choice is remembered: a reader who wants captions gets them
  // on every leaf after, like a book read with the notes open.
  const capToggle = document.getElementById("cap-toggle");
  const capText = document.getElementById("cap-text");
  if (capToggle && capText) {
    const setCaps = (on) => {
      capText.hidden = !on;
      capToggle.setAttribute("aria-expanded", String(on));
      capToggle.textContent = on ? "hide caption" : "caption";
      try {
        on
          ? window.localStorage.setItem("tp:caps", "1")
          : window.localStorage.removeItem("tp:caps");
      } catch (e) {
        /* private mode — the choice lasts one leaf */
      }
    };
    try {
      if (window.localStorage.getItem("tp:caps") === "1") setCaps(true);
    } catch (e) {}
    capToggle.addEventListener("click", () => setCaps(capText.hidden));
    const plateImage = document.querySelector("[data-caption-toggle]");
    if (plateImage)
      plateImage.addEventListener("click", () => setCaps(capText.hidden));
  }

  // Pressing play is what loads YouTube — not turning to the leaf. Until then
  // the page has made no third-party request at all.
  const frame = document.querySelector("[data-film]");
  if (frame) {
    frame.addEventListener("click", () => {
      const id = frame.getAttribute("data-film");
      const player = document.createElement("iframe");
      // nocookie, and rel=0 keeps the end screen to Habib's own channel.
      player.src =
        "https://www.youtube-nocookie.com/embed/" +
        id +
        "?autoplay=1&rel=0&modestbranding=1&playsinline=1";
      player.title = frame.getAttribute("aria-label") || "Film";
      player.allow =
        "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share";
      player.allowFullscreen = true;
      player.setAttribute("frameborder", "0");
      player.className = "film-player";
      frame.replaceWith(player);
      player.focus();
    });
  }

</script>
